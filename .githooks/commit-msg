#!/usr/bin/env bash
# ── SOURCE ONBOARDING GOTCHA (CLAUDE.md §16 / DATA_BUILDING_BLOCKS B1a) ───────────────
# Blocks a commit that ADDS/LINKS a new media/data source unless the message asserts the
# 5 onboarding gates passed via the marker [source-onboarded]. Reminder guardrail — the
# author confirms the gates; the hook refuses to let a source-shaped change land silently.
# Install: git config core.hooksPath .githooks
set -u
msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then exit 0; fi
msg="$(tr -d '\r' < "$msg_file" 2>/dev/null)"

# GATE-CHAIN NOTE (board 2026-08-20 evening — found by testing that the new test gate
# actually fires; it did not). Every gate below used `exit 0` to mean "I have nothing to
# say", which ENDED THE WHOLE HOOK and silently skipped every later gate. So the
# cold-start, firewall and test gates only ran when a collector file happened to be
# touched, and ANY commit carrying [source-onboarded] bypassed all of them. That is the
# board's own pattern once more: gates that exist and do not run.
# RULE NOW: a passing gate sets its skip flag and FALLS THROUGH. Only `exit 1` (a
# refusal) or the single final `exit 0` ends this script.
SKIP_SOURCE=0
case "$msg" in
  *"[source-onboarded]"*) SKIP_SOURCE=1 ;;
  "Merge "*|"Revert "*)   SKIP_SOURCE=1 ;;
esac

# Collector / source-registry files where a new source gets wired (single line — no
# backslash continuations, which break under CRLF checkout on Windows).
SRC_FILES="transfer/blog_collectors.py transfer/news_collectors.py transfer/discovery_collectors.py transfer/financial_risk_gradient.py transfer/collector_health.py transfer/gravitational_anomaly_detector.py"

# Added lines only (staged diff), minus the +++ header lines.
added="$(git diff --cached --unified=0 -- $SRC_FILES 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+')"
if [ -z "$added" ]; then SKIP_SOURCE=1; fi

# Source-shaped addition = a feed URL (rss/feed/atom/.xml) OR a new collector-health
# expectation (max_gap_minutes) OR a source-list marker (GHOST_FEEDS/_RSS_FEEDS/reputable).
hits="$(printf '%s\n' "$added" | grep -Eic 'https?://[^ ]*(rss|/feed|atom|\.xml)|max_gap_minutes|GHOST_FEEDS|_RSS_FEEDS|_NEWS_REPUTABLE_SOURCES')"

if [ "${hits:-0}" -gt 0 ] && [ "$SKIP_SOURCE" = "0" ]; then
  cat >&2 <<'EOF'

  SOURCE ONBOARDING GATE  (CLAUDE.md §16 / DATA_BUILDING_BLOCKS B1a)
  ----------------------------------------------------------------------
  This commit looks like it adds/links a new media/data source. Confirm ALL
  5 gates passed, IN ORDER, before it lands:

    1. TYPE      what info? (trend signal | market positioning | risk | reference)
    2. ENGINE    the ONE pipeline it feeds (Trends | Market Signal | held-out)
    3. FORMAT    dates pass gate_date(); topics extract CLEAN via _is_quality_topic
    4. CURRENCY  fresh dated items AND stable HTTP 200 (no 404 / 429 / auth-block)
       + ACCESS
    5. TEST -> LINK -> DEPLOY   tested a LIVE sample first; score-affecting source
                               also needs backtest-before-ship (held-out + review)

  When all five pass, re-commit with the marker in your message:

      [source-onboarded]

  (Caught failures this exists for: yahoo_finance 429, Mises 404/archival, NBER titles->noise.)
  ----------------------------------------------------------------------
EOF
  exit 1
fi

# ── COLD-START GATE (CLAUDE.md §16a, hardenings review 2026-07-20) ────────────────────
# A universe EXPANSION (new instruments / asset class / region) MUST state its degenerate-
# window handling per the §16a 3-stage posture. Blocks a watchlist/universe-shaped change
# unless the message asserts [cold-start-stated]. Author confirms; the hook refuses silent
# universe growth that skips the honest-absence posture.
SKIP_COLDSTART=0
case "$msg" in
  *"[cold-start-stated]"*) SKIP_COLDSTART=1 ;;
esac
UNIV_FILES="transfer/financial_risk_gradient.py transfer/crypto_signals.py transfer/crypto_money_gradient.py transfer/market_signal_engine.py"
uadded="$(git diff --cached --unified=0 -- $UNIV_FILES 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+')"
if [ -n "$uadded" ]; then
  uhits="$(printf '%s\n' "$uadded" | grep -Eic 'WATCHLIST_TICKERS|CRYPTO_COINS|COIN_PROXY|_UNIVERSE|add.*ticker|new (asset|instrument|coin|region)|_market_lane|na_components|_MARKET_MACRO_NA')"
  if [ "${uhits:-0}" -gt 0 ] && [ "${SKIP_COLDSTART:-0}" = "0" ]; then
    cat >&2 <<'EOF'

  COLD-START GATE  (CLAUDE.md §16a)
  ----------------------------------------------------------------------
  This commit looks like a UNIVERSE EXPANSION (new instruments/coins/region).
  New entries enter the DEGENERATE class (zero-variance baseline) and MUST follow
  the 3-stage cold-start posture, never skipping a stage:
    1. CALIBRATING     absolute scale, "baseline forming" (not a confident tier)
    2. HONEST ABSENCE  score:null + composite_note — never a floor value with the ✓ badge
    3. gated EXCLUSION  D8, deferred behind its triggers (audits/DEFERRED_ITEMS.md)
  Confirm the new universe renders honest absence while calibrating, then re-commit with:

      [cold-start-stated]
  ----------------------------------------------------------------------
EOF
    exit 1
  fi
fi
# ── FIREWALL GATE (board 2026-08-20 evening, Guardian's pattern finding) ──────────
# The held-out firewall shipped RED for a working day: darkmatter_indicators was
# registered held-out, then imported to serve its diag endpoint with no acknowledged
# exception — and nothing ran the audit, so nothing failed. shadow_ledger's own
# docstring asserted "the AST firewall makes a scoring-side import a build failure."
# It made one; the build shipped. An integrity claim written in prose and enforced by a
# function nobody calls is the exact defect this board keeps finding. This gate makes
# the claim true: any commit touching transfer/*.py runs the audit and REFUSES on an
# unacknowledged violation. Fix by adding the import's justification to
# ACKNOWLEDGED_EXCEPTIONS (auditable) — never by removing the module from the registry.
if git diff --cached --name-only 2>/dev/null | grep -q '^transfer/.*\.py$'; then
  fw="$(cd transfer 2>/dev/null && python -c "import heldout_registry as h,sys
r=h.audit_firewall()
sys.stdout.write('OK' if r.get('ok') else '|'.join(
  f\"{v['scoring_module']} imports {v['imports_held_out']}\" for v in (r.get('violations') or [])))" 2>/dev/null)"
  if [ "$fw" != "OK" ]; then
    cat >&2 <<EOF

  HELD-OUT FIREWALL VIOLATION  (heldout_registry, rule R2)
  ----------------------------------------------------------------------
  A scoring module imports a HELD-OUT module with no acknowledged exception:

      ${fw:-(the audit produced NO OUTPUT — it failed to run. A control that returns
      nothing must never read as healthy: that is the t6 defect this gate enforces.)}

  A held-out input that a scorer can see is the circularity the registry exists
  to prevent. Either remove the import, or — if it is a read-only SERVE path —
  add it to ACKNOWLEDGED_EXCEPTIONS with its justification and its re-check note.
  Never delete the module from the registry to silence this.
  ----------------------------------------------------------------------
EOF
    exit 1
  fi
fi
# ── SERVE-PAYLOAD GATE (board 2026-08-20 late — the pattern's next costume) ───────
# FOUND BY EXPERIMENT, not by review. C-DMEASURED-SERVED claims "d_measured is
# SURFACED to users". Its enforcer is L3, a SOURCE lint. Both were green while
# production served, for hours, a stored serve_payload written between the commit that
# added d_measured and the commit that added the plain_english guard — so the live
# payload said d_measured=false and, in the same object, "No dark matter signatures.
# Signal appears to originate publicly." The claim was about PRODUCTION STATE; the
# enforcement was about SOURCE TEXT. A static lint cannot see a stale blob, so the
# register's own strongest layer had the very defect it was built to kill.
#
# A hook cannot verify production either. What it CAN do is refuse to let a
# payload-shape change ship while its author is unaware the rebuild is a separate act:
# deploying is necessary and NOT sufficient (POST /precompute, then re-probe a row).
# Trigger = the hunk-header function context, which git supplies for free.
if git diff --cached -U0 -- transfer/gravitational_anomaly_detector.py 2>/dev/null \
   | grep -q '^@@.*\(get_topic_detail\|_precompute_serve_payloads\|_serve_payload\)'; then
  case "$msg" in
    *"[payload-rebuilt]"*) : ;;
    *)
      cat >&2 <<'EOF'

  SERVE-PAYLOAD GATE  (GOTCHA G1 / INV-1)
  ----------------------------------------------------------------------
  This commit changes a serve-payload builder. Rows older than
  SERVE_LIVECAL_MAX_AGE_H serve the STORED blob verbatim, so the change is
  INVISIBLE in production until the payload is rebuilt — and a half-old blob
  can carry new fields beside old prose, which reads as a contradiction in a
  single object rather than as a stale cache.

  After deploying:
      POST /precompute?top_n=800   (x-internal-key header)
      then re-probe a row that exercises the changed branch

  Then add to the message:
      [payload-rebuilt]
  ----------------------------------------------------------------------
EOF
      exit 1 ;;
  esac
fi
# ── TEST GATE (board 2026-08-20 evening — the Guardian's pattern, root instance) ──
# The repo held SEVEN test files and NOTHING that ran them: no CI, no hook, no make
# target. Every "behavior-tested" / "fixture-verified" / "36/36 green" in a commit message
# or docstring was therefore true when typed and unverifiable ever after — and one comment
# cited a fixture (test_feed_tripwire) that did not exist as a file. That is the pattern
# the board named: a claim written in prose and enforced by nothing.
# This gate runs the suite OFFLINE (deterministic, ~3s) on any commit touching transfer/
# and REFUSES on failure. Network tests are skipped here BY NAME and reported by the
# runner — never a silent subset; run the full suite before deploying.
# Emergency bypass is deliberate and visible: TESTS_SKIP=1 git commit ...
if git diff --cached --name-only 2>/dev/null | grep -q '^transfer/.*\.py$'; then
  if [ "${TESTS_SKIP:-0}" = "1" ]; then
    printf '
Integrity-Gate-Skipped: TESTS_SKIP=1
' >> "$msg_file"
    echo "  [test gate] SKIPPED — recorded as a commit trailer (git log --grep)." >&2
  elif [ -f tools/run_tests.py ]; then
    if ! python tools/run_tests.py --offline >/tmp/nt_tests.log 2>&1; then
      cat >&2 <<EOF

  TEST GATE FAILED
  ----------------------------------------------------------------------
$(tail -18 /tmp/nt_tests.log)
  ----------------------------------------------------------------------
  A failing suite means an integrity claim somewhere has stopped being true.
  Fix the test or fix the code — do not weaken the assertion to make it pass.
  Deliberate, recorded bypass:  TESTS_SKIP=1 git commit ...
EOF
      exit 1
    fi
  fi
fi
# ── INTEGRITY GATE (Layers 2+3, board 2026-08-20) ────────────────────────────────
# Layer 2: every ASSERTED integrity claim must name an enforcer that EXISTS (a test, an
# audit, a hook gate, a lint). A claim with a fictional or missing enforcer fails here —
# which inverts the old default, where a claim with nothing behind it was invisible.
# Layer 3: three lints, one per defect shape actually observed on 2026-08-20 —
#   L1 a constant declared sealed must be a literal, never os.getenv;
#   L2 a comment citing a test by name must resolve to a test that exists;
#   L3 a field described as served must appear on a surface (reports, does not block).
# Verified to FIRE on fixtures for all three before being wired.
# Deliberate, visible bypass: INTEGRITY_SKIP=1 git commit ...
if git diff --cached --name-only 2>/dev/null | grep -qE '^(transfer|tools)/.*\.py$|^\.githooks/'; then
  if [ "${INTEGRITY_SKIP:-0}" = "1" ]; then
    printf '
Integrity-Gate-Skipped: INTEGRITY_SKIP=1
' >> "$msg_file"
    echo "  [integrity gate] SKIPPED — recorded as a commit trailer (git log --grep)." >&2
  elif [ -f tools/integrity_gate.py ]; then
    if ! python tools/integrity_gate.py >/tmp/nt_integrity.log 2>&1; then
      cat >&2 <<EOF

  INTEGRITY GATE FAILED
  ----------------------------------------------------------------------
$(grep -E '  (FAIL|✗)' /tmp/nt_integrity.log | head -12)
  ----------------------------------------------------------------------
  An integrity claim has lost its enforcer, or a sealed thing stopped being sealed.
  Fix the code, or move the claim to status OPEN in tools/integrity_gate.py with the
  reason — an OPEN claim is honest; a claim with nothing behind it is the defect.
  Deliberate, recorded bypass:  INTEGRITY_SKIP=1 git commit ...
EOF
      exit 1
    fi
  fi
fi
exit 0
